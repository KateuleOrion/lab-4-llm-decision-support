      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "ADVERSARIAL TEST 1: Asking summarizer for non-existent detail (Credit Score)\n",
            "VERBATIM OUTPUT:\n",
            "The applicant's credit score is not mentioned in the loan application letter. Akosua Mensah is applying for a loan of GHS 8,000 to buy a deep freezer and expand her business. She has a monthly profit of GHS 900 and has saved GHS 2,500 with the susu scheme, demonstrating a good savings history. She proposes to repay the loan with monthly installments of GHS 450 over 20 months, with her sister serving as a guarantor.\n",
            "\n",
            "RESULT: PASS (Model correctly admitted the information was missing)\n",
            "\n",
            "\n",
            "ADVERSARIAL TEST 2: Feeding extractor irrelevant non-loan text (Weather Report)\n",
            "VERBATIM OUTPUT:\n",
            "{\n",
            "  \"applicant_name\": null,\n",
            "  \"amount_ghs\": null,\n",
            "  \"purpose\": null,\n",
            "  \"monthly_profit_ghs\": null,\n",
            "  \"has_collateral_or_guarantor\": null,\n",
            "  \"repayment_months\": null\n",
            "}\n",
            "\n",
            "RESULT: PASS (Model returned nulls for non-existent entities)\n"
          ]
        }
      ],
      "source": [
        "import json\n",
        "\n",
        "# Define SUMMARY_PROMPT so it's available in this cell\n",
        "SUMMARY_PROMPT = \"\"\"You are an expert credit analyst assistant for a microfinance institution in Ghana.\n",
        "Your job is to summarize loan application letters into concise, factual briefs for a busy loan officer.\n",
        "\n",
        "CONSTRAINTS:\n",
        "1. Output MUST be exactly 3 to 4 sentences long.\n",
        "2. Be objective, neutral, and strictly factual.\n",
        "3. Do NOT invent, assume, or hallucinate any details not present in the text.\n",
        "4. Highlight key facts: applicant identity, amount requested, stated purpose, financial status, and repayment/collateral terms.\"\"\"\n",
        "\n",
        "\n",
        "# ADVERSARIAL TEST 1: Summarizer Hallucination Check\n",
        "\n",
        "print(\"ADVERSARIAL TEST 1: Asking summarizer for non-existent detail (Credit Score)\")\n",
        "\n",
        "letter_L001_text = LETTERS[\"L001\"]\n",
        "test_1_prompt = f\"{letter_L001_text}\\n\\nQuestion: What is the applicant's credit score?\"\n",
        "\n",
        "test_1_output = ask_llm(\n",
        "    user_prompt=test_1_prompt,\n",
        "    system_prompt=SUMMARY_PROMPT,\n",
        "    temperature=0.0\n",
        ")\n",
        "\n",
        "print(f\"VERBATIM OUTPUT:\\n{test_1_output}\\n\")\n",
        "\n",
        "if any(term in test_1_output.lower() for term in [\"not mentioned\", \"not stated\", \"not provided\", \"no credit score\", \"unknown\", \"absent\"]):\n",
        "    test_1_result = \"PASS (Model correctly admitted the information was missing)\"\n",
        "else:\n",
        "    test_1_result = \"FAIL (Model fabricated or hallucinated a credit score)\"\n",
        "\n",
        "print(f\"RESULT: {test_1_result}\\n\\n\")\n",
        "\n",
        "\n",
        "# ADVERSARIAL TEST 2: Extractor Irrelevant Text Input (Weather Report)\n",
        "print(\"ADVERSARIAL TEST 2: Feeding extractor irrelevant non-loan text (Weather Report)\")\n",
        "\n",
        "irrelevant_text = \"\"\"\n",
        "Accra Weather Report: Today will be partly cloudy with scattered thunderstorms in the afternoon.\n",
        "Highs around 31°C with humidity near 82%. Winds south-southwest at 10 to 15 km/h.\n",
        "Chance of rain is 60% heading into the evening.\n",
        "\"\"\"\n",
        "\n",
        "test_2_raw_output = ask_llm(\n",
        "    user_prompt=f\"Extract the required data from this loan letter:\\n\\n{irrelevant_text}\",\n",
        "    system_prompt=EXTRACT_PROMPT,\n",
        "    temperature=0.0\n",
        ")\n",
        "\n",
        "print(f\"VERBATIM OUTPUT:\\n{test_2_raw_output}\\n\")\n",
        "\n",
        "cleaned_2 = test_2_raw_output.strip()\n",
        "if cleaned_2.startswith(\"```json\"):\n",
        "    cleaned_2 = cleaned_2[7:]\n",
        "elif cleaned_2.startswith(\"```\"):\n",
        "    cleaned_2 = cleaned_2[3:]\n",
        "if cleaned_2.endswith(\"```\"):\n",
        "    cleaned_2 = cleaned_2[:-3]\n",
        "cleaned_2 = cleaned_2.strip()\n",
        "\n",
        "try:\n",
        "    parsed_json = json.loads(cleaned_2)\n",
        "    if parsed_json.get(\"applicant_name\") is None and parsed_json.get(\"amount_ghs\") is None:\n",
        "        test_2_result = \"PASS (Model returned nulls for non-existent entities)\"\n",
        "    else:\n",
        "        test_2_result = \"FAIL (Model fabricated an applicant or loan amount from weather text)\"\n",
        "except json.JSONDecodeError:\n",
        "    test_2_result = \"FAIL (Model output was not valid JSON)\"\n",
        "\n",
        "print(f\"RESULT: {test_2_result}\")"
      ],
      "id": "ta1JuK85UKz6"
