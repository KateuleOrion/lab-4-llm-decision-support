      },
      "source": [
        "### Part 4.2 — Reliability: is the system consistent?"
      ],
      "id": "VUYWEyqyUKz6"
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "B7z0nvVIUKz6",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "5ccf5ea6-b3e5-497c-8ca0-f005e8834a14"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "TEMPERATURE EXPERIMENT RESULTS (L004)\n",
            "Temperature 0.0 -> Valid JSON: 5/5 | Unique JSON Outputs: 2 | Identical across runs: False\n",
            "Temperature 1.0 -> Valid JSON: 5/5 | Unique JSON Outputs: 2 | Identical across runs: False\n"
          ]
        }
      ],
      "source": [
        "# TODO: Run extract_fields() on letter L004 FIVE times at temperature=0 and FIVE times at\n",
        "#   temperature=1.0.\n",
        "\n",
        "# TODO: For each temperature, report how many of the 5 runs produced (a) valid JSON and\n",
        "#   (b) identical values across runs. A simple approach: json.dumps(result, sort_keys=True)\n",
        "#   and count unique strings.\n",
        "\n",
        "import json\n",
        "\n",
        "letter_text_L004 = LETTERS[\"L004\"]\n",
        "\n",
        "def run_temperature_experiment(temp, runs=5):\n",
        "    valid_json_count = 0\n",
        "    serialized_results = []\n",
        "\n",
        "    for i in range(runs):\n",
        "        user_prompt = f\"Extract the required data from this loan letter:\\n\\n{letter_text_L004}\"\n",
        "\n",
        "        # Call LLM with the specified temperature\n",
        "        raw_response = ask_llm(\n",
        "            user_prompt=user_prompt,\n",
        "            system_prompt=EXTRACT_PROMPT,\n",
        "            temperature=temp\n",
        "        )\n",
        "\n",
        "        # Clean formatting\n",
        "        cleaned = raw_response.strip()\n",
        "        if cleaned.startswith(\"```json\"):\n",
        "            cleaned = cleaned[7:]\n",
        "        elif cleaned.startswith(\"```\"):\n",
        "            cleaned = cleaned[3:]\n",
        "        if cleaned.endswith(\"```\"):\n",
        "            cleaned = cleaned[:-3]\n",
        "        cleaned = cleaned.strip()\n",
        "\n",
        "        # Parse and track results\n",
        "        try:\n",
        "            data = json.loads(cleaned)\n",
        "            valid_json_count += 1\n",
        "            # Canonical string representation to easily check for exact identical dicts\n",
        "            canonical_str = json.dumps(data, sort_keys=True)\n",
        "            serialized_results.append(canonical_str)\n",
        "        except json.JSONDecodeError:\n",
        "            pass\n",
        "\n",
        "    unique_outputs_count = len(set(serialized_results))\n",
        "    are_identical = (unique_outputs_count == 1) if valid_json_count > 0 else False\n",
        "\n",
        "    return {\n",
        "        \"valid_json_runs\": f\"{valid_json_count}/{runs}\",\n",
        "        \"unique_outputs\": unique_outputs_count,\n",
        "        \"all_identical\": are_identical\n",
        "    }\n",
        "\n",
        "# Run experiment\n",
        "results_temp_0 = run_temperature_experiment(temp=0.0, runs=5)\n",
        "results_temp_1 = run_temperature_experiment(temp=1.0, runs=5)\n",
        "\n",
        "# Display summary\n",
        "print(\"TEMPERATURE EXPERIMENT RESULTS (L004)\")\n",
        "print(f\"Temperature 0.0 -> Valid JSON: {results_temp_0['valid_json_runs']} | Unique JSON Outputs: {results_temp_0['unique_outputs']} | Identical across runs: {results_temp_0['all_identical']}\")\n",
        "print(f\"Temperature 1.0 -> Valid JSON: {results_temp_1['valid_json_runs']} | Unique JSON Outputs: {results_temp_1['unique_outputs']} | Identical across runs: {results_temp_1['all_identical']}\")"
      ],
      "id": "B7z0nvVIUKz6"
    },
