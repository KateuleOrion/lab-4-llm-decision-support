      "source": [
        "# TODO: For the three letters in GOLD, compare your extracted DataFrame to the gold values\n",
        "#   field by field. Compute per-field accuracy across the three letters\n",
        "#   (name matching can be case-insensitive; numbers must match exactly).\n",
        "\n",
        "# TODO: Display a small table: rows = fields, columns = L001 / L003 / L006 / accuracy.\n",
        "\n",
        "import pandas as pd\n",
        "\n",
        "# Define ground-truth gold data for L001, L003, and L006\n",
        "GOLD_DATA = {\n",
        "    \"L001\": {\n",
        "        \"applicant_name\": \"Kwame Mensah\",\n",
        "        \"amount_ghs\": 15000,\n",
        "        \"purpose\": \"buy new cocoa spraying equipment and fertilizers\",\n",
        "        \"monthly_profit_ghs\": 3500,\n",
        "        \"has_collateral_or_guarantor\": True,\n",
        "        \"repayment_months\": 12\n",
        "    },\n",
        "    \"L003\": {\n",
        "        \"applicant_name\": \"Efua Darko\",\n",
        "        \"amount_ghs\": 10000,\n",
        "        \"purpose\": \"purchase industrial sewing machines and fabrics\",\n",
        "        \"monthly_profit_ghs\": 2800,\n",
        "        \"has_collateral_or_guarantor\": True,\n",
        "        \"repayment_months\": 15\n",
        "    },\n",
        "    \"L006\": {\n",
        "        \"applicant_name\": \"Kofi\",\n",
        "        \"amount_ghs\": 50000,\n",
        "        \"purpose\": \"start three businesses: car washing, provision shop, and phone import\",\n",
        "        \"monthly_profit_ghs\": None,\n",
        "        \"has_collateral_or_guarantor\": False,\n",
        "        \"repayment_months\": 12\n",
        "    }\n",
        "}\n",
        "\n",
        "fields = [\n",
        "    \"applicant_name\",\n",
        "    \"amount_ghs\",\n",
        "    \"purpose\",\n",
        "    \"monthly_profit_ghs\",\n",
        "    \"has_collateral_or_guarantor\",\n",
        "    \"repayment_months\"\n",
        "]\n",
        "\n",
        "evaluation_rows = []\n",
        "\n",
        "# Compare extracted data vs. GOLD field-by-field\n",
        "for field in fields:\n",
        "    row = {\"Field\": field}\n",
        "    matches = 0\n",
        "    total = len(GOLD_DATA)\n",
        "\n",
        "    for letter_id, gold_values in GOLD_DATA.items():\n",
        "        # Get extracted value for this letter\n",
        "        extracted_val = df.loc[df[\"letter_id\"] == letter_id, field].values[0] if letter_id in df[\"letter_id\"].values else None\n",
        "        gold_val = gold_values[field]\n",
        "\n",
        "        # Match checking logic\n",
        "        if field == \"applicant_name\":\n",
        "            # Case-insensitive name match\n",
        "            is_match = str(extracted_val).strip().lower() == str(gold_val).strip().lower()\n",
        "        elif field == \"purpose\":\n",
        "            # Semantic/substring match check for purpose descriptions\n",
        "            is_match = bool(extracted_val and any(term in str(extracted_val).lower() for term in str(gold_val).lower().split()))\n",
        "        else:\n",
        "            # Exact match for numbers, booleans, and nulls\n",
        "            is_match = extracted_val == gold_val\n",
        "\n",
        "        row[letter_id] = \"✅ Match\" if is_match else f\"❌ Diff ({extracted_val})\"\n",
        "        if is_match:\n",
        "            matches += 1\n",
        "\n",
        "    row[\"Accuracy\"] = f\"{(matches / total) * 100:.1f}%\"\n",
        "    evaluation_rows.append(row)\n",
        "\n",
        "# Convert to DataFrame and display summary table\n",
        "eval_df = pd.DataFrame(evaluation_rows)\n",
        "eval_df.set_index(\"Field\", inplace=True)\n",
        "eval_df"
      ],
      "id": "pOp7juSQUKz6"
    },
