      },
      "source": [
        "---\n",
        "# Section 1 — Talking to an LLM Programmatically\n",
        "\n",
        "Before building anything, understand the anatomy of an API call: **messages and roles**\n",
        "(`system`, `user`, `assistant`), and the **generation parameters** (`temperature`,\n",
        "`max_tokens`)."
      ],
      "id": "Uu-XmGTeUKzw"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "NSyLzdBQUKzx"
      },
      "source": [
        "### Part 1.1 — Your first API call"
      ],
      "id": "NSyLzdBQUKzx"
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "49gFMGP_UKzy",
        "outputId": "47cbb566-f6bb-4786-941d-9be99c69a3ff"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "LLM Answer\n",
            "The capital of France is Paris.\n",
            "\n",
            " Token Usage\n",
            "CompletionUsage(completion_tokens=8, prompt_tokens=48, total_tokens=56, completion_tokens_details=None, prompt_tokens_details=None, queue_time=0.172794927, prompt_time=0.002484136, completion_time=0.01090438, total_time=0.013388516)\n"
          ]
        }
      ],
      "source": [
        "# TODO: Write a helper function you will reuse for the WHOLE lab:\n",
        "#\n",
        "# def ask_llm(user_prompt, system_prompt=\"You are a helpful assistant.\",\n",
        "#             temperature=0.7, max_tokens=500):\n",
        "#     response = client.chat.completions.create(\n",
        "#         model=MODEL,\n",
        "#         messages=[\n",
        "#             {\"role\": \"system\", \"content\": system_prompt},\n",
        "#             {\"role\": \"user\",   \"content\": user_prompt},\n",
        "#         ],\n",
        "#         temperature=temperature,\n",
        "#         max_tokens=max_tokens,\n",
        "#     )\n",
        "#     return response.choices[0].message.content\n",
        "\n",
        "\n",
        "\n",
        "def ask_llm(user_prompt, system_prompt=\"You are a helpful assistant.\",\n",
        "            temperature=0.7, max_tokens=500, return_usage=False):\n",
        "    response = client.chat.completions.create(\n",
        "        model=MODEL,\n",
        "        messages=[\n",
        "            {\"role\": \"system\", \"content\": system_prompt},\n",
        "            {\"role\": \"user\",   \"content\": user_prompt},\n",
        "        ],\n",
        "        temperature=temperature,\n",
        "        max_tokens=max_tokens,\n",
        "    )\n",
        "\n",
        "    if return_usage:\n",
        "        return response.choices[0].message.content, response.usage\n",
        "    return response.choices[0].message.content\n",
        "\n",
        "# TODO: Call it once and print answer and token usage\n",
        "prompt = \"What is the capital of France?\"\n",
        "answer, usage = ask_llm(prompt, return_usage=True)\n",
        "\n",
        "print(\"LLM Answer\")\n",
        "print(answer)\n",
        "\n",
        "print(\"\\n Token Usage\")\n",
        "print(usage)"
      ],
      "id": "49gFMGP_UKzy"
    },
